<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distribución interna (Apple Developer Enterprise Program) para JAMF. -->
	<key>method</key>
	<string>enterprise</string>

	<!-- ⚠️ REEMPLAZAR: Team ID de Apple (10 caracteres). Debe coincidir con
	     DEVELOPMENT_TEAM en Config/Base.xcconfig. -->
	<key>teamID</key>
	<string>REEMPLAZAR_TEAM_ID</string>

	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<!-- ⚠️ REEMPLAZAR: nombre del perfil de aprovisionamiento in-house para este bundle. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.dinas.driver</key>
		<string>REEMPLAZAR_NOMBRE_PERFIL_INHOUSE</string>
	</dict>

	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
